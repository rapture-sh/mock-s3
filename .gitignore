# rust
/target
**/*.rs.bk
*.pdb

# console frontend
/web/node_modules
# rust-embed needs this folder to exist at compile time. It is not tracked: the console
# crate's build.rs creates it, because `vite build` empties the directory and would take
# any tracked placeholder with it.
/web/dist
/web/.vite

# client-side test suite
/tests/node_modules
/tests/.vitest

# object data (--data defaults to ./data outside the container)
/data

# env files
.env*

# editors and os
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# typescript
*.tsbuildinfo

# local claude code settings
.claude/settings.local.json
