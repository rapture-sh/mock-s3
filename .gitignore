# rust
/target
**/*.rs.bk
*.pdb

# console frontend
/web/node_modules
# rust-embed needs this folder to exist at compile time, or the console crate, and so
# the whole workspace, fails to build in a checkout where nobody has run `pnpm build`.
# The contents are ignored; the directory itself is tracked.
/web/dist/*
!/web/dist/.gitkeep
/web/.vite

# client-side test suite
/tests/node_modules
/tests/.vitest

# object data (--data defaults to ./data outside the container)
/data

# env files
.env*

# editors and os
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# typescript
*.tsbuildinfo

# local claude code settings
.claude/settings.local.json
